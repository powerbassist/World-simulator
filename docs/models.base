filters:
  and:
    - 'file.inFolder("docs")'
    - 'file.ext == "md"'
    - or:
        - 'file.hasTag("model")'
        - 'file.name.endsWith("-model")'

formulas:
  days_since_edit: '(now() - file.mtime).days.floor()'
  linked_from: 'file.backlinks.length'

properties:
  file.name:
    displayName: "Model"
  file.mtime:
    displayName: "Last edited"
  formula.days_since_edit:
    displayName: "Days since edit"
  formula.linked_from:
    displayName: "Linked from"

views:
  - type: table
    name: "By last edit"
    order:
      - file.name
      - file.mtime
      - formula.days_since_edit
      - formula.linked_from
    sort:
      - property: file.mtime
        direction: DESC

  - type: table
    name: "Least linked"
    order:
      - file.name
      - formula.linked_from
      - file.mtime
    sort:
      - property: formula.linked_from
        direction: ASC
